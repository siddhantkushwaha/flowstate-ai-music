# Flask App Environment
FLASK_ENV=development
PORT=5050

# LLM Provider Configuration
# Options: 'gemini' (Cloud AI Studio), 'ollama' (Local Open-Source), 'mock'
LLM_PROVIDER=gemini

# Google Gemini / Gemma Configuration
# Get free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemma-2-27b-it

# Ollama Local LLM Configuration (Required if LLM_PROVIDER=ollama)
# Download Ollama: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
